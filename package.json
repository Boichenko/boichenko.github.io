{
  "name": "hanna-boychenko-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "dev": "vite",
    "generate:cv": "python3 scripts/generate_cv.py",
    "build:site": "vite build && node scripts/prerender.mjs",
    "build": "npm run generate:cv && npm run build:site",
    "lint": "eslint .",
    "check:generated": "git diff --exit-code -- public/Hanna-Boychenko-Technical-PM-Web3-AI-CV.pdf",
    "check": "npm run lint && npm run build && npm run check:generated",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.2.2"
  }
}
